{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "php": {
      "command": ["intelephense", "--stdio"],
      "extensions": [".php"]
    },
    "css": {
      "command": ["tailwindcss-language-server", "--stdio"],
      "extensions": [".css", ".html", ".blade.php", ".php", ".twig", ".vue", ".jsx", ".tsx"],
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    }
  },
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=jmksvtmwvouxxdtesncb",
      "enabled": true
    }
  }
}
